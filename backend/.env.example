# ==========================================
# UC-Centralized Backend Environment Configuration (Example)
# Copy this file to .env and replace placeholders with your actual credentials.
# ==========================================

# Server Port
PORT=5000

# Environment Mode (development | production)
NODE_ENV=development

# Database Connection (MongoDB)
# Local MongoDB: mongodb://localhost:27017/uc-centralized
# MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/uc-centralized?retryWrites=true&w=majority
MONGO_URI=mongodb://localhost:27017/uc-centralized

# JWT Authentication & OAuth Token Secret
# Generate a strong random string (e.g., using `openssl rand -hex 32` or node crypto)
ACCESS_TOKEN_SECRET=your_jwt_secret_key_here

# Frontend Client URL (for CORS & redirect links)
CLIENT_URL=http://localhost:5173

# Nodemailer SMTP Email Credentials (used for sending password reset & verification emails)
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_gmail_app_password

# Cloudinary Storage Credentials (for image & media uploads)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
