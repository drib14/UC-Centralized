{
  "version": 2,
  "builds": [
    {
      "src": "backend/api/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "client/package.json",
      "use": "@vercel/static-build",
      "config": {
        "distDir": "build"
      }
    }
  ],
  "rewrites": [
    { "source": "/api/:path*", "destination": "/backend/api/index.js" },
    { "source": "/:path*", "destination": "/client/build/index.html" }
  ]
}
