# ==========================================
# UC-Centralized Client Environment Configuration (Example)
# Copy this file to .env and adjust variables as needed.
# ==========================================

# Backend API Endpoint (Leave empty if using Vite dev proxy in local development)
VITE_API_URL=http://localhost:5000

# WebSocket / Socket.IO Server Endpoint
VITE_SOCKET_URL=http://localhost:5000

# OAuth Client ID for testing integration
VITE_UC_CLIENT_ID=your_uc_client_id_here
