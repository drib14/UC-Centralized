# ==========================================
# UC-Centralized Client Environment Configuration (Example)
# Copy this file to .env or .env.local and adjust variables as needed.
# ==========================================

# Backend API Endpoint (Leave empty in production on Vercel to use relative /api proxy)
VITE_API_URL=

# WebSocket / Socket.IO Server Endpoint
# - For local development: http://localhost:5000 (automatically used in .env.development)
# - For Vercel Serverless: Leave empty (real-time gracefully falls back to efficient HTTP polling)
# - For Dedicated Node Server (Render / Railway / VPS): https://your-backend-server.com
VITE_SOCKET_URL=

# OAuth Client ID for testing integration
VITE_UC_CLIENT_ID=your_uc_client_id_here
